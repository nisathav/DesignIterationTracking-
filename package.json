{
  "name": "design-iteration-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "LAN-hosted tracker for design considerations, iterations and flags",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p server/tsconfig.json && tsc -p client/tsconfig.json && vite build --config client/vite.config.ts",
    "start": "node dist/server/index.js",
    "dev": "tsx watch server/src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json",
    "user": "node dist/server/cli.js",
    "dev:client": "vite --config client/vite.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^8.3.0",
    "@tanstack/react-query": "^5.104.1",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.5",
    "nodemailer": "^10.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
